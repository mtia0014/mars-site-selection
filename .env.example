# MARS 环境变量示例 —— 复制为 .env 并填入真实值（.env 已被 gitignore，不会误传）

# DeepSeek LLM API Key（必填）
# 缺失/无效时 init_llm() 失败并自动降级为「模拟模式」，结果不可用于真实选址决策
DEEPSEEK_API_KEY=

# 可选：DeepSeek API 地址（默认官方地址，一般无需改）
# 国内网络不通时可指向第三方中转地址（key 同时换成中转方提供的）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 嵌入模型（可选，默认 BAAI/bge-m3，1024 维）
# 换模型必须重建向量库（create_vectordb_v6.py），否则维度不一致加载失败
EMBEDDING_MODEL=BAAI/bge-m3
